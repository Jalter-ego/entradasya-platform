# Copiar a infra/postgres/.env (fuera de Git) y reemplazar las claves.
# Cada clave debe coincidir con la de DATABASE_URL en services/<servicio>/.env.
# Mínimo 12 caracteres. Generar una con:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"

# --- Conexión de administrador (solo para crear bases y usuarios) ------------
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
# PGPASSWORD=clave-del-administrador

# --- Una clave por usuario exclusivo -----------------------------------------
AUTH_DB_PASSWORD=cambiar-clave-auth
EVENTS_DB_PASSWORD=cambiar-clave-events
ORDERS_DB_PASSWORD=cambiar-clave-orders
PAYMENTS_DB_PASSWORD=cambiar-clave-payments
TICKETS_DB_PASSWORD=cambiar-clave-tickets
CHECKIN_DB_PASSWORD=cambiar-clave-checkin

# 1 crea también <servicio>_test (bases desechables para las pruebas). 0 no.
WITH_TEST_DBS=0
