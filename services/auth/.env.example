HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgres://auth_user:CAMBIAR@127.0.0.1:5432/auth_db
DB_SCHEMA=public
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
JWT_PRIVATE_KEY_FILE=./keys/auth-private.pem
# JWT_PRIVATE_KEY admite PEM con saltos \n si se omite JWT_PRIVATE_KEY_FILE.
JWT_ALG=RS256
JWT_ISSUER=entradasya-auth
JWT_AUDIENCE=entradasya
JWT_TTL_SECONDS=28800
# Solo para npm run seed en una base de demo. Completar con una contraseña local.
DEMO_PASSWORD=
# LOG_LEVEL=silent
