{
  "name": "@entradasya/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "keys:generate": "node scripts/generate-keys.mjs",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "test": "node --env-file-if-exists=.env.test --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jose": "^6.0.11",
    "pg": "^8.16.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "node-pg-migrate": "^7.9.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
