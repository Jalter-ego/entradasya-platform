# --- Servicio ---------------------------------------------------------------
PORT=3007
# Solo loopback: el navegador entra por Nginx, no directo al servicio.
HOST=127.0.0.1
# debug | info | warn | error | silent
LOG_LEVEL=info

# --- Base de datos -----------------------------------------------------------
# Postgres local (base exclusiva de checkin):
DATABASE_URL=postgresql://checkin_user:cambiar-esta-clave@localhost:5432/checkin_db
DATABASE_SSL=false
# Schema donde viven las tablas. En local con base propia: public.
# En Supabase (una sola base para todos): usar un schema por servicio, p. ej. checkin.
DB_SCHEMA=public

# --- JWT (lo emite auth, P1) --------------------------------------------------
# Clave PÚBLICA de verificación. Usar el archivo o la variable (con \n en una sola línea).
JWT_PUBLIC_KEY_FILE=./keys/auth-public.pem
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----"
JWT_ALG=RS256
JWT_ISSUER=entradasya-auth
JWT_AUDIENCE=entradasya

# --- Integración con tickets (P5) --------------------------------------------
# Dirección directa del servicio tickets (sin pasar por Nginx).
TICKETS_URL=http://127.0.0.1:3005
# Timeout HTTP hacia tickets en milisegundos (mínimo 500, máximo 30000).
INTERNAL_TIMEOUT_MS=5000
# Token compartido únicamente entre checkin y tickets (mínimo 24 caracteres).
# Debe coincidir exactamente con INTERNAL_TOKEN_CHECKIN en services/tickets/.env.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_TOKEN_CHECKIN=reemplazar-por-token-exclusivo-de-checkin
