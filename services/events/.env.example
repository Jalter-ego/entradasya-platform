# --- Servicio ---------------------------------------------------------------
PORT=3002
# Solo loopback: el navegador entra por Nginx, no directo al servicio.
HOST=127.0.0.1
# Moneda acordada por el equipo (ISO 4217). Importes siempre en unidades menores.
CURRENCY=BOB
# Portadas persistentes fuera del repositorio. Ruta relativa al iniciar desde services/events.
EVENTS_STORAGE_DIR=../../../.local/entradasya/event-covers
# debug | info | warn | error | silent
LOG_LEVEL=info

# --- Base de datos -----------------------------------------------------------
# Postgres local:
DATABASE_URL=postgres://events_user:cambiar-esta-clave@localhost:5432/events_db
DATABASE_SSL=false
# Schema donde viven las tablas. En local con base propia: public.
# En Supabase (una sola base para todos): usar un schema por servicio, p. ej. events.
DB_SCHEMA=public

# Supabase (ejemplo; usar "Session pooler" o conexión directa, NO el transaction pooler 6543):
# DATABASE_URL=postgres://postgres.<ref-del-proyecto>:<clave>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_SSL=true
# DB_SCHEMA=events

# --- JWT (lo emite auth, P1) --------------------------------------------------
# Clave PÚBLICA de verificación. Usar el archivo o la variable (con \n en una sola línea).
JWT_PUBLIC_KEY_FILE=./keys/auth-public.pem
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----"
JWT_ALG=RS256
JWT_ISSUER=entradasya-auth
JWT_AUDIENCE=entradasya

# --- API interna ---------------------------------------------------------------
# Token que solo conocen orders y events (mínimo 24 caracteres). Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_TOKEN_ORDERS=reemplazar-por-un-token-largo-y-aleatorio

# --- Semilla de demo (npm run seed) -------------------------------------------
# UUID del organizador de demo; acordarlo con auth (P1) para que coincida con su semilla.
SEED_ORGANIZER_ID=00000000-0000-4000-8000-000000000001
