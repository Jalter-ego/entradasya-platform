# --- Servicio ---------------------------------------------------------------
PORT=3006
# Solo loopback: notifications es interno; ni el navegador ni Nginx llegan a él.
HOST=127.0.0.1
# debug | info | warn | error | silent
LOG_LEVEL=info

# --- API interna ---------------------------------------------------------------
# Token que solo conocen orders y notifications (mínimo 24 caracteres). Debe ser IGUAL a
# NOTIFICATIONS_INTERNAL_TOKEN del .env de orders y distinto de los demás tokens.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_TOKEN_ORDERS=reemplazar-por-token-exclusivo-orders-notifications

# --- SMTP (Mailpit local; ver infra/mailpit/README.md) ---------------------------
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# Mailpit local no pide credenciales. Si se configuran, van las dos.
# SMTP_USER=
# SMTP_PASSWORD=
# Límite de cada envío (ms). Menor que HTTP_TIMEOUT_MS de orders (5000).
SMTP_TIMEOUT_MS=4000
MAIL_FROM="EntradasYa <no-reply@entradasya.local>"

# --- Enlace del correo -----------------------------------------------------------
# URL pública de la web (Nginx). El correo enlaza a <PUBLIC_WEB_URL>/mis-entradas?orderId=...
PUBLIC_WEB_URL=http://localhost:8080
# Zona horaria con la que se muestra la fecha del evento.
MAIL_TIMEZONE=America/La_Paz
