PORT=3003
# Solo loopback: el navegador entra por Nginx, no directo al servicio.
HOST=127.0.0.1
# debug | info | warn | error | silent
LOG_LEVEL=info

# Base exclusiva de orders. No usar la base de otro servicio.
DATABASE_URL=postgres://orders_user:cambiar-esta-clave@localhost:5432/orders_db
DATABASE_SSL=false
