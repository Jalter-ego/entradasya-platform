PORT=3003
HOST=127.0.0.1
# debug | info | warn | error | silent
LOG_LEVEL=info

DATABASE_URL=postgres://orders_user:cambiar-esta-clave@localhost:5432/orders_db
DATABASE_SSL=false

JWT_PUBLIC_KEY_FILE=./keys/auth-public.pem

JWT_ALG=RS256
JWT_ISSUER=entradasya-auth
JWT_AUDIENCE=entradasya

# Timeouts de llamadas internas (ms). tickets genera PDF: límite mayor y acotado.
HTTP_TIMEOUT_MS=5000
TICKETS_TIMEOUT_MS=20000

# Servicios internos (directo, sin Nginx). Cada token es exclusivo del par orders <-> servicio
# y debe ser IGUAL al INTERNAL_TOKEN_ORDERS del .env de ese servicio. Mínimo 24 caracteres.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EVENTS_URL=http://127.0.0.1:3002
EVENTS_INTERNAL_TOKEN=reemplazar-por-token-exclusivo-orders-events
PAYMENTS_URL=http://127.0.0.1:3004
PAYMENTS_INTERNAL_TOKEN=reemplazar-por-token-exclusivo-orders-payments
TICKETS_URL=http://127.0.0.1:3005
TICKETS_INTERNAL_TOKEN=reemplazar-por-token-exclusivo-orders-tickets
NOTIFICATIONS_URL=http://127.0.0.1:3006
NOTIFICATIONS_INTERNAL_TOKEN=reemplazar-por-token-exclusivo-orders-notifications
