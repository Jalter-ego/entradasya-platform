# --- Servicio ---------------------------------------------------------------
PORT=3004
# Solo loopback: payments es interno; ni el navegador ni Nginx llegan a él.
HOST=127.0.0.1
# debug | info | warn | error | silent
LOG_LEVEL=info

# --- Base de datos -----------------------------------------------------------
# Base y usuario exclusivos, creados con infra/postgres/setup-databases.*
DATABASE_URL=postgres://payments_user:cambiar-esta-clave@localhost:5432/payments_db
DATABASE_SSL=false
# Schema de las tablas. En local con base propia: public.
# En Supabase (una base para todos): un schema por servicio, p. ej. payments.
DB_SCHEMA=public

# --- API interna ---------------------------------------------------------------
# Token que solo conocen orders y payments (mínimo 24 caracteres). Debe ser IGUAL a
# PAYMENTS_INTERNAL_TOKEN del .env de orders. Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_TOKEN_ORDERS=reemplazar-por-token-exclusivo-orders-payments
