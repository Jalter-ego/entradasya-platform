PORT=3005
HOST=127.0.0.1
LOG_LEVEL=info

# Base exclusiva de tickets. No usar la base de otro servicio.
DATABASE_URL="postgresql://postgres:86EightySix@localhost:1435/tickets?schema=public"
DATABASE_SSL=false

# Ruta persistente. Las rutas relativas se resuelven desde services/tickets.
TICKETS_STORAGE_DIR=./data/tickets
DISPLAY_TIME_ZONE=America/La_Paz

# Clave PÚBLICA de auth (P1). Nunca copiar aquí su clave privada.
JWT_PUBLIC_KEY_FILE=./keys/auth-public.pem
# Alternativa al archivo, con \n entre líneas:
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ALG=RS256
JWT_ISSUER=entradasya-auth
JWT_AUDIENCE=entradasya

# Credenciales distintas, cada una compartida solo con su consumidor.
# Generar cada una: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_TOKEN_ORDERS=reemplazar-por-token-exclusivo-de-orders
INTERNAL_TOKEN_CHECKIN=reemplazar-por-token-exclusivo-de-checkin
