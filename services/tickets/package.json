{
  "name": "@entradasya/tickets",
  "version": "0.1.0",
  "private": true,
  "description": "EntradasYa - emisión, PDF, QR y descarga de entradas (P5)",
  "type": "module",
  "engines": { "node": ">=22.11" },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "test": "node --env-file-if-exists=.env.test node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jose": "^6.0.11",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.0",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/pdfkit": "^0.17.3",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.3",
    "node-pg-migrate": "^7.9.1",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
